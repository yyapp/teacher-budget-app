# Supabase 프로젝트 URL (https://프로젝트이름.supabase.co)
SUPABASE_URL=https://abcd1234.supabase.co

# Supabase 서비스 역할 키 (서버 전용, 관리자 권한)
# 프로젝트 설정 → API → 서비스 역할 비밀키
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 접속 비밀번호 (Supabase Auth 미사용 시). 설정 안 하면 인증 없이 접근.
ACCESS_PASSWORD=개인비밀번호

# 영수증 자동 인식용 Upstage API 키 (선택)
UPSTAGE_API_KEY=up_여기에_키_입력

# 로컬 포트 (Railway에서는 자동 할당되므로 없어도 됨)
FLASK_PORT=5003
