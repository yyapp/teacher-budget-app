# 이 파일을 복사해서 이름을 ".env" 로 바꿔 쓰세요. (.env 는 Git에 올라가지 않습니다)
# 값은 따옴표 없이 "이름=값" 형태로 적습니다.

# 영수증 자동 인식(Upstage)을 쓰려면 본인의 API 키를 넣으세요.
# 비워 두면 자동 인식만 꺼지고 나머지 기능은 그대로 쓸 수 있습니다.
UPSTAGE_API_KEY=

# --- 아래는 여러 사람이 접속하게 열 때만 쓰는 선택 항목입니다 (내 컴퓨터에서만 쓰면 필요 없음) ---
# 접속 비밀번호: 설정하면 모든 화면이 로그인을 요구합니다. (비밀번호를 코드나 저장소에 적지 마세요)
# APP_ACCESS_PASSWORD=
# 자동 인식 호출 횟수 상한(숫자). 사용량(비용) 보호용
# OCR_MAX_CALLS=
